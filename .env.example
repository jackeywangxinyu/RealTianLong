# 复制为 .env（已被 gitignore）后填写；运行时从环境变量读取，代码中永不硬编码密钥
GEMINI_API_KEY=
# 主持人之声（叙述、场外问答、终章）与解释玩家输入的快模型分开配；思考档位 minimal/low/medium/high，default 用模型默认
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING=low
GEMINI_FAST_MODEL=gemini-3.1-flash-lite
GEMINI_FAST_THINKING=minimal
# 1：把模型调用结果缓存在 .cache/llm（评测复现用；正常游玩不开）
TIANLONG_LLM_CACHE=

# 可选：真实持久化后端；不填则使用内存存储与 Qdrant 本地模式
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
QDRANT_URL=
